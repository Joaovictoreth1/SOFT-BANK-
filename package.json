  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 src/js tests *.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "html-validate src/index.html",
    "typecheck": "tsc --project jsconfig.json",
