    "@phosphor-icons/web": "2.1.2",
    "@playwright/test": "1.65.1",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "html-validate": "11.22.1",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
